{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/VcpkgToolchain.cmake"
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug + ASan/UBSan (Ninja)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MYAPP_SANITIZER": "address" }
    },
    {
      "name": "debug-nosan",
      "displayName": "Debug without sanitizers (Ninja)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "tsan",
      "displayName": "Debug + ThreadSanitizer (Linux/macOS, Ninja)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MYAPP_SANITIZER": "thread" },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ci",
      "displayName": "Debug + ASan, warnings as errors (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYAPP_SANITIZER": "address",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "ci-gcc",
      "displayName": "ci with GCC (Linux)",
      "inherits": "ci",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "ci-clang",
      "displayName": "ci with Clang (Linux)",
      "inherits": "ci",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "docs",
      "displayName": "Doxygen docs (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MYAPP_BUILD_TESTS": "ON",
        "MYAPP_BUILD_FUZZERS": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Debug + coverage (Ninja, clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYAPP_USE_LLVM_CLANG": "ON",
        "MYAPP_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Debug + libFuzzer (Ninja, clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYAPP_USE_LLVM_CLANG": "ON",
        "MYAPP_BUILD_TESTS": "OFF",
        "MYAPP_BUILD_FUZZERS": "ON"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (Windows only)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs2022",
      "toolchainFile": "${sourceDir}/cmake/VcpkgToolchain.cmake",
      "cacheVariables": { "MYAPP_WINDOWS_TARGET_ARCH": "x64", "VCPKG_TARGET_TRIPLET": "x64-windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2022-arm64",
      "displayName": "Visual Studio 2022 ARM64 (Windows only)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "ARM64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs2022-arm64",
      "toolchainFile": "${sourceDir}/cmake/VcpkgToolchain.cmake",
      "cacheVariables": { "MYAPP_WINDOWS_TARGET_ARCH": "arm64", "VCPKG_TARGET_TRIPLET": "arm64-windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2022-x86",
      "displayName": "Visual Studio 2022 x86 (Windows only)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "Win32", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs2022-x86",
      "toolchainFile": "${sourceDir}/cmake/VcpkgToolchain.cmake",
      "cacheVariables": { "MYAPP_WINDOWS_TARGET_ARCH": "x86", "VCPKG_TARGET_TRIPLET": "x86-windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2022-x86_x64",
      "displayName": "Visual Studio 2022 x86 host + x64 target (Windows only)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "host=x86", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs2022-x86_x64",
      "toolchainFile": "${sourceDir}/cmake/VcpkgToolchain.cmake",
      "cacheVariables": { "MYAPP_WINDOWS_TARGET_ARCH": "x64", "VCPKG_TARGET_TRIPLET": "x64-windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (Windows only, CMake 4.2+)",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs2026",
      "toolchainFile": "${sourceDir}/cmake/VcpkgToolchain.cmake",
      "cacheVariables": { "MYAPP_WINDOWS_TARGET_ARCH": "x64", "VCPKG_TARGET_TRIPLET": "x64-windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2026-arm64",
      "displayName": "Visual Studio 2026 ARM64 (Windows only, CMake 4.2+)",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "ARM64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs2026-arm64",
      "toolchainFile": "${sourceDir}/cmake/VcpkgToolchain.cmake",
      "cacheVariables": { "MYAPP_WINDOWS_TARGET_ARCH": "arm64", "VCPKG_TARGET_TRIPLET": "arm64-windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2026-x86",
      "displayName": "Visual Studio 2026 x86 (Windows only, CMake 4.2+)",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "Win32", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs2026-x86",
      "toolchainFile": "${sourceDir}/cmake/VcpkgToolchain.cmake",
      "cacheVariables": { "MYAPP_WINDOWS_TARGET_ARCH": "x86", "VCPKG_TARGET_TRIPLET": "x86-windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2026-x86_x64",
      "displayName": "Visual Studio 2026 x86 host + x64 target (Windows only, CMake 4.2+)",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "host=x86", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs2026-x86_x64",
      "toolchainFile": "${sourceDir}/cmake/VcpkgToolchain.cmake",
      "cacheVariables": { "MYAPP_WINDOWS_TARGET_ARCH": "x64", "VCPKG_TARGET_TRIPLET": "x64-windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "debug-nosan", "configurePreset": "debug-nosan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "ci-gcc", "configurePreset": "ci-gcc" },
    { "name": "ci-clang", "configurePreset": "ci-clang" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "docs", "configurePreset": "docs", "targets": ["docs"] },
    { "name": "vs2022", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "vs2022-arm64", "configurePreset": "vs2022-arm64", "configuration": "Debug" },
    { "name": "vs2022-x86", "configurePreset": "vs2022-x86", "configuration": "Debug" },
    { "name": "vs2022-x86_x64", "configurePreset": "vs2022-x86_x64", "configuration": "Debug" },
    { "name": "vs2026", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-arm64", "configurePreset": "vs2026-arm64", "configuration": "Debug" },
    { "name": "vs2026-x86", "configurePreset": "vs2026-x86", "configuration": "Debug" },
    { "name": "vs2026-x86_x64", "configurePreset": "vs2026-x86_x64", "configuration": "Debug" },
    { "name": "coverage-report", "configurePreset": "coverage", "targets": ["coverage"] },
    { "name": "fuzz-run", "configurePreset": "fuzz", "targets": ["fuzz-run"] }
  ],
  "testPresets": [
    { "name": "test-base", "hidden": true, "output": { "outputOnFailure": true } },
    {
      "name": "test-asan",
      "hidden": true,
      "inherits": "test-base",
      "environment": {
        "ASAN_OPTIONS": "detect_stack_use_after_return=1:strict_string_checks=1:check_initialization_order=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    { "name": "release", "inherits": "test-base", "configurePreset": "release" },
    { "name": "debug", "inherits": "test-asan", "configurePreset": "debug" },
    { "name": "debug-nosan", "inherits": "test-base", "configurePreset": "debug-nosan" },
    {
      "name": "tsan",
      "inherits": "test-base",
      "configurePreset": "tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1" }
    },
    { "name": "ci", "inherits": "test-asan", "configurePreset": "ci" },
    { "name": "ci-gcc", "inherits": "test-asan", "configurePreset": "ci-gcc" },
    { "name": "ci-clang", "inherits": "test-asan", "configurePreset": "ci-clang" },
    { "name": "coverage", "inherits": "test-base", "configurePreset": "coverage" },
    {
      "name": "vs2022",
      "inherits": "test-base",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-arm64",
      "inherits": "test-base",
      "configurePreset": "vs2022-arm64",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-x86",
      "inherits": "test-base",
      "configurePreset": "vs2022-x86",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-x86_x64",
      "inherits": "test-base",
      "configurePreset": "vs2022-x86_x64",
      "configuration": "Debug"
    },
    {
      "name": "vs2026",
      "inherits": "test-base",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-arm64",
      "inherits": "test-base",
      "configurePreset": "vs2026-arm64",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-x86",
      "inherits": "test-base",
      "configurePreset": "vs2026-x86",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-x86_x64",
      "inherits": "test-base",
      "configurePreset": "vs2026-x86_x64",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "displayName": "Configure and build release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" }
      ]
    },
    {
      "name": "debug-nosan",
      "displayName": "Configure and build debug-nosan (the debugger's build)",
      "steps": [
        { "type": "configure", "name": "debug-nosan" },
        { "type": "build", "name": "debug-nosan" }
      ]
    },
    {
      "name": "test",
      "displayName": "Configure, build and test with ASan/UBSan",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "ci",
      "displayName": "Configure, build and test like CI",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "test", "name": "ci" }
      ]
    },
    {
      "name": "coverage-report",
      "displayName": "Configure and build with coverage, then write the report",
      "steps": [
        { "type": "configure", "name": "coverage" },
        { "type": "build", "name": "coverage-report" }
      ]
    },
    {
      "name": "fuzz-run",
      "displayName": "Configure and build the fuzzers, then run them",
      "steps": [
        { "type": "configure", "name": "fuzz" },
        { "type": "build", "name": "fuzz-run" }
      ]
    },
    {
      "name": "docs",
      "displayName": "Configure and build Doxygen docs and diagrams",
      "steps": [
        { "type": "configure", "name": "docs" },
        { "type": "build", "name": "docs" }
      ]
    }
  ]
}
