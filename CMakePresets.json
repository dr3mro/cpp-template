{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },

    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug + ASan/UBSan (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYAPP_SANITIZER": "address"
      }
    },
    {
      "name": "debug-nosan",
      "displayName": "Debug without sanitizers (Ninja)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "tsan",
      "displayName": "Debug + ThreadSanitizer (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYAPP_SANITIZER": "thread"
      }
    },
    {
      "name": "ci",
      "displayName": "Debug + ASan, warnings as errors (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYAPP_SANITIZER": "address",
        "MYAPP_WARNINGS_AS_ERRORS": "ON"
      }
    },

    {
      "name": "docs",
      "displayName": "Doxygen docs (Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MYAPP_BUILD_TESTS": "OFF",
        "MYAPP_BUILD_FUZZERS": "OFF",
        "VCPKG_MANIFEST_INSTALL": "OFF"
      }
    },

    {
      "name": "coverage",
      "displayName": "Debug + coverage (Ninja, clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYAPP_USE_LLVM_CLANG": "ON",
        "MYAPP_ENABLE_COVERAGE": "ON",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate -fcoverage-mapping"
      }
    },

    {
      "name": "fuzz",
      "displayName": "Debug + libFuzzer (Ninja, clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYAPP_USE_LLVM_CLANG": "ON",
        "MYAPP_BUILD_TESTS": "OFF",
        "MYAPP_BUILD_FUZZERS": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },

    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (Windows only)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs2022",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (Windows only)",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs2026",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "debug-nosan", "configurePreset": "debug-nosan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "docs", "configurePreset": "docs", "targets": ["docs"] },
    { "name": "diagrams", "configurePreset": "docs", "targets": ["class-diagrams"] },
    { "name": "vs2022", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "vs2026", "configurePreset": "vs2026", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "debug-nosan", "configurePreset": "debug-nosan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "ci", "configurePreset": "ci", "output": { "outputOnFailure": true } }
  ],
  "workflowPresets": [
    {
      "name": "docs",
      "displayName": "Configure and build Doxygen docs",
      "steps": [
        { "type": "configure", "name": "docs" },
        { "type": "build", "name": "docs" }
      ]
    },
    {
      "name": "diagrams",
      "displayName": "Configure and render class diagrams",
      "steps": [
        { "type": "configure", "name": "docs" },
        { "type": "build", "name": "diagrams" }
      ]
    }
  ]
}
