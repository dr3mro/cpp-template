<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Universal Visual Studio project for the template.

    It opens in Visual Studio 2019 (16.7+), 2022 and 2026 without CMake:
    sources and headers are picked up by wildcard, so a new file under src/ or
    include/ is part of the build after a reload of the solution and shows up
    in Solution Explorer.

    The project is ReadOnlyProject: Visual Studio never edits or saves it, so
    MSBuild constructs that the IDE otherwise warns about (wildcards, several
    files in one item) are allowed. Settings change by editing this file, or a
    <name>.user.props next to it (imported below if it exists, git-ignored).
    See https://learn.microsoft.com/cpp/build/reference/vcxproj-files-and-wildcards

    The compiler and linker settings are in myapp.props, the targets that
    write the generated headers in myapp.targets. Both files are shared with
    the test project, so every project of the template builds the same way.

    new-project.sh and new-project.ps1 rename this file, replace the
    placeholder GUID with a fresh one and set the C++ standard.
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{3F2A6B1C-9D4E-4C7A-8B5F-1E2D3C4B5A69}</ProjectGuid>
    <RootNamespace>myapp</RootNamespace>
    <ProjectName>myapp</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Marks this as the hand-written project. Directory.Build.props is
         imported by the C++ targets further down, so the marker is set in
         time: only this project gets its output redirected to build/Windows/<arch>/vs/,
         never the CMake-generated solutions under build/Windows/<arch>/vs2022 or
         build/Windows/<arch>/vs2026. -->
    <VsBuildRootProject>true</VsBuildRootProject>
    <!-- The project keeps wildcard items, which the IDE supports only in a
         read-only project. Visual Studio then never rewrites it; new files on
         disk are still discovered (reload the solution), and Property Pages
         and "Add > New Item" cannot save into it. Change settings by editing
         this file, or a myapp.user.props next to it. -->
    <ReadOnlyProject>true</ReadOnlyProject>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <!-- An app has main.cpp; a library project does not. -->
    <ConfigurationType Condition="Exists('$(MSBuildProjectDirectory)\main.cpp')">Application</ConfigurationType>
    <ConfigurationType Condition="!Exists('$(MSBuildProjectDirectory)\main.cpp')">StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType Condition="Exists('$(MSBuildProjectDirectory)\main.cpp')">Application</ConfigurationType>
    <ConfigurationType Condition="!Exists('$(MSBuildProjectDirectory)\main.cpp')">StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'" Label="Configuration">
    <ConfigurationType Condition="Exists('$(MSBuildProjectDirectory)\main.cpp')">Application</ConfigurationType>
    <ConfigurationType Condition="!Exists('$(MSBuildProjectDirectory)\main.cpp')">StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'" Label="Configuration">
    <ConfigurationType Condition="Exists('$(MSBuildProjectDirectory)\main.cpp')">Application</ConfigurationType>
    <ConfigurationType Condition="!Exists('$(MSBuildProjectDirectory)\main.cpp')">StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="Shared">
    <!-- The compiler and linker settings every project of this template
         shares live in myapp.props, so that the app and the test project
         build the same way. -->
    <Import Project="$(MSBuildProjectDirectory)\myapp.props" Label="Shared" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <!-- The output paths (OutDir, IntDir, the vcpkg folder and the folder for
         the generated headers) live in Directory.Build.props, so that every
         file MSBuild writes stays under build/Windows/<arch>/vs/. -->
    <TargetName>myapp</TargetName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Wildcards: files added under src/ or include/ are built after a reload
         (and appear in Solution Explorer). One Include per item: a
         semicolon-separated list is the other construct the IDE warns about.
         main.cpp sits in the project root. tests/ and fuzz/ are not part of
         this project: the tests are the separate myapp_tests project, and the
         fuzz targets belong to the CMake build. -->
    <ClCompile Include="src\**\*.cpp" />
    <ClCompile Include="main.cpp" Condition="Exists('main.cpp')" />
    <ClInclude Include="include\**\*.hpp" />
    <ClInclude Include="include\**\*.h" />
    <ClInclude Include="src\**\*.hpp" />
    <ClInclude Include="src\**\*.h" />
    <None Include="README.md" />
    <None Include=".clang-format" />
    <None Include=".clang-tidy" />
    <None Include="cmake\templates\version.hpp.in" />
    <None Include="VERSION" />
    <!-- A project without vcpkg has no manifest. -->
    <None Include="vcpkg.json" Condition="Exists('vcpkg.json')" />
  </ItemGroup>
  <PropertyGroup>
    <!-- vcpkg: the manifest is used when vcpkg is around, so dependencies added
         to vcpkg.json later also work here. Without vcpkg the project still
         builds. A project without a manifest has no vcpkg at all, so the
         manifest mode stays off even where vcpkg is installed. -->
    <VcpkgEnableManifest Condition="'$(VcpkgRoot)'!='' or '$(VCPKG_ROOT)'!=''">true</VcpkgEnableManifest>
    <VcpkgEnabledFeature Condition="'$(VcpkgRoot)'!='' or '$(VCPKG_ROOT)'!=''"></VcpkgEnabledFeature>
    <VcpkgEnableManifest Condition="'$(VcpkgRoot)'=='' and '$(VCPKG_ROOT)'==''">false</VcpkgEnableManifest>
    <VcpkgEnableManifest Condition="!Exists('$(MSBuildProjectDirectory)\vcpkg.json')">false</VcpkgEnableManifest>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The debugger starts in the project root, so data files next to the
         sources are found. -->
    <LocalDebuggerWorkingDirectory>$(MSBuildProjectDirectory)\</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
  <!-- Optional per-user settings. The project is read-only in Visual Studio,
       so this is the place for machine-specific changes (an extra include
       folder, a different warning level, a debugger setting) that should not
       be committed. The file is git-ignored. -->
  <Import Project="$(MSBuildProjectName).user.props" Condition="Exists('$(MSBuildProjectName).user.props')" />
  <!-- The targets every project of this template shares: the generated
       headers are written before every compile. -->
  <Import Project="$(MSBuildProjectDirectory)\myapp.targets" Label="Shared" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
