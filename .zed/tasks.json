[
  { "label": "build release", "command": "cmake --workflow --preset release", "hide": "on_success" },
  { "label": "build debug", "command": "cmake --preset debug && cmake --build --preset debug", "hide": "on_success" },
  { "label": "build debug-nosan", "command": "cmake --workflow --preset debug-nosan", "hide": "on_success" },
  { "label": "run", "command": "cmake --workflow --preset release && ./build/release/myapp", "use_new_terminal": true },
  { "label": "run debug", "command": "cmake --preset debug && cmake --build --preset debug && ./build/debug/myapp", "use_new_terminal": true },
  { "label": "test", "command": "cmake --workflow --preset test", "hide": "never" },
  { "label": "build tsan", "command": "cmake --preset tsan && cmake --build --preset tsan", "hide": "on_success" },
  { "label": "build ci", "command": "cmake --preset ci && cmake --build --preset ci", "hide": "on_success" },
  { "label": "build coverage", "command": "cmake --preset coverage && cmake --build --preset coverage", "hide": "on_success" },
  { "label": "coverage report", "command": "cmake --workflow --preset coverage-report", "use_new_terminal": true },
  { "label": "test ci", "command": "cmake --workflow --preset ci", "hide": "never" },
  { "label": "build fuzz", "command": "cmake --preset fuzz && cmake --build --preset fuzz", "hide": "on_success" },
  { "label": "fuzz run", "command": "cmake --workflow --preset fuzz-run", "use_new_terminal": true },
  { "label": "format", "command": "cmake --preset release && cmake --build --preset release --target format", "hide": "on_success" },
  { "label": "cmake-lint", "command": "cmake --preset release && cmake --build --preset release --target cmake-lint", "hide": "never" },
  { "label": "tidy", "command": "cmake --preset release && cmake --build --preset release --target tidy", "hide": "never" },
  { "label": "docs", "command": "cmake --workflow --preset docs", "hide": "on_success" },
  { "label": "clean", "command": "cmake --preset debug && cmake --build --preset debug --target clean", "hide": "on_success" },
  { "label": "clean all", "command": "cmake -P cmake/DistClean.cmake", "hide": "on_success" }
]
