[
  { "label": "build release", "command": "cmake --preset release && cmake --build --preset release", "hide": "on_success" },
  { "label": "build debug", "command": "cmake --preset debug && cmake --build --preset debug", "hide": "on_success" },
  { "label": "run", "command": "cmake --preset release && cmake --build --preset release && ./build/release/myapp", "use_new_terminal": true },
  { "label": "run debug", "command": "cmake --preset debug && cmake --build --preset debug && ./build/debug/myapp", "use_new_terminal": true },
  { "label": "test", "command": "cmake --preset debug && cmake --build --preset debug && ctest --preset debug", "hide": "never" },
  { "label": "format", "command": "cmake --preset release && cmake --build --preset release --target format", "hide": "on_success" },
  { "label": "tidy", "command": "cmake --preset release && cmake --build --preset release --target tidy", "hide": "never" },
  { "label": "docs", "command": "cmake --preset release && cmake --build --preset release --target docs", "hide": "on_success" },
  { "label": "class diagrams", "command": "cmake --preset release && cmake --build --preset release --target class-diagrams", "hide": "on_success" },
  { "label": "diagrams", "command": "cmake --preset release && cmake --build --preset release --target diagrams", "hide": "on_success" },
  { "label": "clean all", "command": "rm -rf build", "hide": "on_success" }
]
