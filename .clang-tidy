# clang-tidy settings (read by clangd in Zed and by the `tidy` CMake target)
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -performance-avoid-endl

WarningsAsErrors: ''
# Only analyse our own headers under include/ and src/ (the trailing slash
# plus a word boundary keeps the generated include/<name>/ folder out).
HeaderFilterRegex: '.*/(include|src)/myapp/.*'
ExcludeHeaderFilterRegex: '.*/generated/.*'
FormatStyle: file
