# clang-tidy settings (read by clangd in Zed and by the `tidy` CMake target)
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -performance-avoid-endl

WarningsAsErrors: ''
# Only analyse our own headers under include/ and src/. This is a POSIX
# extended regex (no lookahead), so it cannot exclude the generated
# build/**/generated/include/<name>/ tree on its own; the tidy target passes
# an -header-filter anchored at the absolute source directory instead, which
# keeps generated headers out. (ExcludeHeaderFilterRegex, which would let this
# file do the exclusion, needs clang-tidy 19+; CI ships 18.)
HeaderFilterRegex: '.*/(include|src)/myapp/.*'
FormatStyle: file
