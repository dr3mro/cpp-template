# Doxygen configuration for the class graphs generated by the `docs` target.
# CMake fills the @...@ values. The graphs are kept as .dot sources
# (DOT_CLEANUP = NO) so they can be copied into docs/diagrams/classes/ and
# rendered from there.
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/class-diagrams"
INPUT                  = @CMAKE_SOURCE_DIR@/include @CMAKE_SOURCE_DIR@/src @MYAPP_DOXY_EXTRA_INPUT@
FILE_PATTERNS          = *.hpp *.cpp
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
HAVE_DOT               = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 50
DOT_UML_DETAILS        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GRAPHICAL_HIERARCHY    = YES
DOT_CLEANUP            = NO
