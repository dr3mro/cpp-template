# Build output
/build/
/bin/
/obj/
# vcpkg (in-tree) output
/vcpkg_installed/
/vcpkg-binary-cache/
# Created by IDEs when editing presets
CMakeUserPresets.json
*.o
*.obj
*.d
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Generated documentation (includes docs/diagrams/)
/docs/

# Debugger and profiling output
*.dSYM/
*.gdb_history
*.lldb
*.prof
*.profraw

# IDE and editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vs/
.idea/
*.swp
*.swo
# Visual Studio: the solution and the project are tracked, the rest is local
*.vcxproj.user
*.user.props
*.suo
# Zed / clangd
.cache/
compile_commands.json
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Temporary files (new-project-*.txt: the generator's output, if it was
# interrupted before it could remove it)
/new-project-*.txt
*.tmp
*.temp
*~

# libFuzzer findings (written to the directory the fuzzer runs in)
crash-*
leak-*
timeout-*
oom-*
slow-unit-*
