# targets - show the build targets and the preset each one uses
#
# Usage:
#   cx targets
#
# Prints the targets the template defines, including the three that carry the
# project's own name. The preset column is what `cx build <target>` uses when
# no preset is named. Any target can be combined with a preset:
# `cx build release format-check`.

# The widest value in <values>, but at least <minimum>.
function(_cx_width values minimum out)
    set(_width "${minimum}")
    foreach(_value IN LISTS values)
        string(LENGTH "${_value}" _length)
        if(_length GREATER _width)
            set(_width "${_length}")
        endif()
    endforeach()
    set(${out} "${_width}" PARENT_SCOPE)
endfunction()

# Pad <text> with spaces to <width>.
function(_cx_pad text width out)
    string(LENGTH "${text}" _length)
    math(EXPR _pad "${width} - ${_length}")
    if(_pad GREATER 0)
        string(REPEAT " " ${_pad} _spaces)
    else()
        set(_spaces "")
    endif()
    set(${out} "${text}${_spaces}" PARENT_SCOPE)
endfunction()

_cx_target_names(_targets)
_cx_default_preset(_default)
set(_rows_preset "")
set(_rows_what "")
foreach(_target IN LISTS _targets)
    _cx_target_default_preset("${_target}" _preset)
    list(APPEND _rows_preset "${_preset}")
    if(_target STREQUAL "tidy")
        set(_what "clang-tidy")
    elseif(_target STREQUAL "cmake-lint")
        set(_what "cmake-lint over the CMake files")
    elseif(_target STREQUAL "format" OR _target STREQUAL "format-check")
        set(_what "clang-format (in place / check only)")
    elseif(_target STREQUAL "docs")
        set(_what "the Doxygen website")
    elseif(_target STREQUAL "coverage")
        set(_what "the LLVM coverage report")
    elseif(_target STREQUAL "fuzz-run")
        set(_what "run every fuzzer for a bounded time")
    elseif(_target STREQUAL "package")
        set(_what "a CPack archive")
    elseif(_target STREQUAL "install")
        set(_what "install the build")
    elseif(_target STREQUAL "clean")
        set(_what "the preset's compiled files")
    elseif(_target STREQUAL "all")
        set(_what "everything in the preset")
    elseif(_target MATCHES "_tests$")
        set(_what "the unit test program")
    elseif(_target MATCHES "_lib$")
        set(_what "the library")
    else()
        set(_what "the program")
    endif()
    list(APPEND _rows_what "${_what}")
endforeach()

_cx_width("${_targets}" 7 _width_target)
_cx_width("${_rows_preset}" 6 _width_preset)
_cx_width("${_rows_what}" 4 _width_what)
_cx_pad("TARGET" ${_width_target} _h1)
_cx_pad("PRESET" ${_width_preset} _h2)
set(_text "${_h1}  ${_h2}  WHAT\n")
_cx_pad("" ${_width_target} _s1)
string(REPLACE " " "-" _s1 "${_s1}")
_cx_pad("" ${_width_preset} _s2)
string(REPLACE " " "-" _s2 "${_s2}")
_cx_pad("" ${_width_what} _s3)
string(REPLACE " " "-" _s3 "${_s3}")
string(APPEND _text "${_s1}  ${_s2}  ${_s3}\n")
set(_index 0)
foreach(_target IN LISTS _targets)
    list(GET _rows_preset ${_index} _preset)
    list(GET _rows_what ${_index} _what)
    _cx_pad("${_target}" ${_width_target} _c1)
    _cx_pad("${_preset}" ${_width_preset} _c2)
    string(APPEND _text "${_c1}  ${_c2}  ${_what}\n")
    math(EXPR _index "${_index} + 1")
endforeach()
string(APPEND _text "\nDefault preset on this host: ${_default}\n")
_cx_say("${_text}")
