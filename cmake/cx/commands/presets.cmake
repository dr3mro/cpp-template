# presets - show every configure preset and whether it works here
#
# Usage:
#   cx presets
#
# Prints a table: the preset, its short alias, what it is for (the preset's
# displayName), whether its condition allows this host, and which one is the
# default (marked with *). Hidden presets are not user presets, so they are
# left out. Your own CMakeUserPresets.json is included.

# The short alias for <preset>, or an empty string.
function(_cx_presets_alias preset out)
    set(_alias "")
    if(preset STREQUAL "debug")
        set(_alias "asan, msan")
    elseif(preset STREQUAL "debug-nosan")
        set(_alias "nosan")
    elseif(preset STREQUAL "ci-gcc")
        set(_alias "gcc")
    elseif(preset STREQUAL "ci-clang")
        set(_alias "clang")
    elseif(preset STREQUAL "vs2026")
        set(_alias "vs")
    endif()
    set(${out} "${_alias}" PARENT_SCOPE)
endfunction()

# The widest value in <values>, but at least <minimum>.
function(_cx_width values minimum out)
    set(_width "${minimum}")
    foreach(_value IN LISTS values)
        string(LENGTH "${_value}" _length)
        if(_length GREATER _width)
            set(_width "${_length}")
        endif()
    endforeach()
    set(${out} "${_width}" PARENT_SCOPE)
endfunction()

# Pad <text> with spaces to <width>.
function(_cx_pad text width out)
    string(LENGTH "${text}" _length)
    math(EXPR _pad "${width} - ${_length}")
    if(_pad GREATER 0)
        string(REPEAT " " ${_pad} _spaces)
    else()
        set(_spaces "")
    endif()
    set(${out} "${text}${_spaces}" PARENT_SCOPE)
endfunction()

_cx_collect_presets(_names _display _hidden _conditions)
_cx_default_preset(_default)

set(_rows_preset "")
set(_rows_alias "")
set(_rows_purpose "")
set(_rows_host "")
set(_rows_default "")
set(_index 0)
foreach(_name IN LISTS _names)
    list(GET _hidden ${_index} _flag)
    if(NOT _flag)
        list(GET _display ${_index} _purpose)
        list(GET _conditions ${_index} _condition)
        _cx_condition_ok("${_condition}" _available)
        _cx_presets_alias("${_name}" _alias)
        if(_alias STREQUAL "")
            set(_alias "-")
        endif()
        if(_available)
            set(_host "yes")
        else()
            set(_host "no")
        endif()
        if(_name STREQUAL _default)
            set(_mark "*")
        else()
            set(_mark "-")
        endif()
        list(APPEND _rows_preset "${_name}")
        list(APPEND _rows_alias "${_alias}")
        list(APPEND _rows_purpose "${_purpose}")
        list(APPEND _rows_host "${_host}")
        list(APPEND _rows_default "${_mark}")
    endif()
    math(EXPR _index "${_index} + 1")
endforeach()

_cx_width("${_rows_preset}" 6 _width_preset)
_cx_width("${_rows_alias}" 5 _width_alias)
_cx_width("${_rows_purpose}" 7 _width_purpose)
_cx_width("${_rows_host}" 4 _width_host)

_cx_pad("PRESET" ${_width_preset} _h1)
_cx_pad("ALIAS" ${_width_alias} _h2)
_cx_pad("PURPOSE" ${_width_purpose} _h3)
_cx_pad("HOST" ${_width_host} _h4)
set(_text "${_h1}  ${_h2}  ${_h3}  ${_h4}  DEFAULT\n")
_cx_pad("" ${_width_preset} _s1)
string(REPLACE " " "-" _s1 "${_s1}")
_cx_pad("" ${_width_alias} _s2)
string(REPLACE " " "-" _s2 "${_s2}")
_cx_pad("" ${_width_purpose} _s3)
string(REPLACE " " "-" _s3 "${_s3}")
_cx_pad("" ${_width_host} _s4)
string(REPLACE " " "-" _s4 "${_s4}")
string(APPEND _text "${_s1}  ${_s2}  ${_s3}  ${_s4}  -------\n")
set(_index 0)
foreach(_name IN LISTS _rows_preset)
    list(GET _rows_alias ${_index} _alias)
    list(GET _rows_purpose ${_index} _purpose)
    list(GET _rows_host ${_index} _host)
    list(GET _rows_default ${_index} _mark)
    _cx_pad("${_name}" ${_width_preset} _c1)
    _cx_pad("${_alias}" ${_width_alias} _c2)
    _cx_pad("${_purpose}" ${_width_purpose} _c3)
    _cx_pad("${_host}" ${_width_host} _c4)
    string(APPEND _text "${_c1}  ${_c2}  ${_c3}  ${_c4}  ${_mark}\n")
    math(EXPR _index "${_index} + 1")
endforeach()
string(APPEND _text "\nDefault on this host: ${_default}\n")
string(APPEND _text "Aliases: nosan -> debug-nosan, gcc -> ci-gcc, clang -> ci-clang,\n")
string(APPEND _text "         asan -> debug, msan -> debug + memory sanitizer, vs -> vs2026.\n")
string(APPEND _text "Plain words work too: cx build nosan, cx test release.\n")
_cx_say("${_text}")
