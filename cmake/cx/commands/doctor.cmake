# doctor - check the tools the project needs and print a table
#
# Usage:
#   cx doctor
#
# Checks CMake 3.25+, Ninja, a C++ compiler, git, VCPKG_ROOT (only when the
# project has vcpkg.json), clang-format 20+, clang-tidy, cmake-lint, watchexec,
# Doxygen with Graphviz, and the developer shell on Windows. Every missing item comes
# with an install command for this operating system. The exit status is
# non-zero only when a required tool is missing.

# Install commands for Windows.
function(_cx_doctor_install_windows tool out)
    if(tool STREQUAL "cmake")
        set(_command "winget install Kitware.CMake")
    elseif(tool STREQUAL "ninja")
        set(_command "winget install Ninja-build.Ninja")
    elseif(tool STREQUAL "compiler")
        set(_command "Visual Studio Installer: Desktop development with C++")
    elseif(tool STREQUAL "git")
        set(_command "winget install Git.Git")
    elseif(tool STREQUAL "vcpkg")
        set(_command "git clone https://github.com/microsoft/vcpkg.git C:\\vcpkg, "
                     "run bootstrap-vcpkg.bat, then set VCPKG_ROOT")
    elseif(tool STREQUAL "clang-format" OR tool STREQUAL "clang-tidy")
        set(_command "winget install LLVM.LLVM")
    elseif(tool STREQUAL "cmake-lint")
        set(_command "pipx install cmakelang==0.6.13")
    elseif(tool STREQUAL "watchexec")
        set(_command "winget install watchexec.watchexec")
    elseif(tool STREQUAL "doxygen")
        set(_command "winget install Doxygen.Doxygen")
    elseif(tool STREQUAL "dot")
        set(_command "winget install Graphviz.Graphviz")
    else()
        set(_command "open Developer PowerShell for VS from the Start menu")
    endif()
    set(${out} "${_command}" PARENT_SCOPE)
endfunction()

# Install commands for macOS.
function(_cx_doctor_install_macos tool out)
    if(tool STREQUAL "cmake")
        set(_command "brew install cmake")
    elseif(tool STREQUAL "ninja")
        set(_command "brew install ninja")
    elseif(tool STREQUAL "compiler" OR tool STREQUAL "git")
        set(_command "xcode-select --install")
    elseif(tool STREQUAL "vcpkg")
        set(_command "git clone https://github.com/microsoft/vcpkg.git ~/.vcpkg && "
                     "~/.vcpkg/bootstrap-vcpkg.sh -disableMetrics")
    elseif(tool STREQUAL "clang-format" OR tool STREQUAL "clang-tidy")
        set(_command "brew install llvm")
    elseif(tool STREQUAL "cmake-lint")
        set(_command "pipx install cmakelang==0.6.13")
    elseif(tool STREQUAL "watchexec")
        set(_command "brew install watchexec")
    elseif(tool STREQUAL "doxygen" OR tool STREQUAL "dot")
        set(_command "brew install doxygen graphviz")
    else()
        set(_command "nothing to do")
    endif()
    set(${out} "${_command}" PARENT_SCOPE)
endfunction()

# Install commands for Linux.
function(_cx_doctor_install_linux tool out)
    if(tool STREQUAL "cmake")
        set(_command "sudo apt install cmake  (or your package manager)")
    elseif(tool STREQUAL "ninja")
        set(_command "sudo apt install ninja-build")
    elseif(tool STREQUAL "compiler")
        set(_command "sudo apt install build-essential")
    elseif(tool STREQUAL "git")
        set(_command "sudo apt install git")
    elseif(tool STREQUAL "vcpkg")
        set(_command "git clone https://github.com/microsoft/vcpkg.git ~/.vcpkg && "
                     "~/.vcpkg/bootstrap-vcpkg.sh -disableMetrics")
    elseif(tool STREQUAL "clang-format")
        set(_command "pipx install clang-format  (or sudo apt install clang-format)")
    elseif(tool STREQUAL "clang-tidy")
        set(_command "sudo apt install clang-tidy")
    elseif(tool STREQUAL "cmake-lint")
        set(_command "pipx install cmakelang==0.6.13")
    elseif(tool STREQUAL "watchexec")
        set(_command "cargo install watchexec-cli  (or cargo binstall watchexec-cli)")
    elseif(tool STREQUAL "doxygen" OR tool STREQUAL "dot")
        set(_command "sudo apt install doxygen graphviz")
    else()
        set(_command "nothing to do")
    endif()
    set(${out} "${_command}" PARENT_SCOPE)
endfunction()

# The install command for <tool> on this host.
function(_cx_doctor_install tool out)
    if(CMAKE_HOST_WIN32)
        _cx_doctor_install_windows("${tool}" _command)
    elseif(APPLE)
        _cx_doctor_install_macos("${tool}" _command)
    else()
        _cx_doctor_install_linux("${tool}" _command)
    endif()
    set(${out} "${_command}" PARENT_SCOPE)
endfunction()

# The widest value in <values>, but at least <minimum>.
function(_cx_doctor_width values minimum out)
    set(_width "${minimum}")
    foreach(_value IN LISTS values)
        string(LENGTH "${_value}" _length)
        if(_length GREATER _width)
            set(_width "${_length}")
        endif()
    endforeach()
    set(${out} "${_width}" PARENT_SCOPE)
endfunction()

# Pad <text> with spaces to <width>.
function(_cx_doctor_pad text width out)
    string(LENGTH "${text}" _length)
    math(EXPR _pad "${width} - ${_length}")
    if(_pad GREATER 0)
        string(REPEAT " " ${_pad} _spaces)
    else()
        set(_spaces "")
    endif()
    set(${out} "${text}${_spaces}" PARENT_SCOPE)
endfunction()

# Append one row of the doctor table.
macro(_cx_doctor_row check status detail)
    list(APPEND _checks "${check}")
    list(APPEND _statuses "${status}")
    list(APPEND _details "${detail}")
endmacro()

set(_checks "")
set(_statuses "")
set(_details "")
set(_required_missing OFF)

# ---- required ----------------------------------------------------------------
if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.25)
    _cx_doctor_row("cmake" "ok" "${CMAKE_VERSION}")
else()
    _cx_doctor_install(cmake _command)
    _cx_doctor_row("cmake" "missing" "needs 3.25+: ${_command}")
    set(_required_missing ON)
endif()

find_program(_ninja NAMES ninja)
if(_ninja)
    execute_process(COMMAND "${_ninja}" --version
                    OUTPUT_VARIABLE _ninja_version OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET)
    _cx_doctor_row("ninja" "ok" "${_ninja_version} (${_ninja})")
else()
    _cx_doctor_install(ninja _command)
    _cx_doctor_row("ninja" "missing" "install: ${_command}")
    set(_required_missing ON)
endif()

find_program(_compiler NAMES c++ g++ clang++ cl)
if(_compiler)
    _cx_doctor_row("C++ compiler" "ok" "${_compiler}")
else()
    _cx_doctor_install(compiler _command)
    _cx_doctor_row("C++ compiler" "missing" "install: ${_command}")
    set(_required_missing ON)
endif()

if(EXISTS "${CX_ROOT}/vcpkg.json")
    if(DEFINED ENV{VCPKG_ROOT} AND EXISTS "$ENV{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
        _cx_doctor_row("VCPKG_ROOT" "ok" "$ENV{VCPKG_ROOT}")
    else()
        _cx_doctor_install(vcpkg _command)
        _cx_doctor_row("VCPKG_ROOT" "missing" "set it after installing vcpkg: ${_command}")
        set(_required_missing ON)
    endif()
endif()

find_program(_git NAMES git)
if(_git)
    execute_process(COMMAND "${_git}" --version
                    OUTPUT_VARIABLE _git_version OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET)
    _cx_doctor_row("git" "ok" "${_git_version}")
else()
    _cx_doctor_install(git _command)
    _cx_doctor_row("git" "missing" "install: ${_command}")
    set(_required_missing ON)
endif()

# ---- optional tooling ---------------------------------------------------------
set(_llvm_hints /opt/homebrew/opt/llvm/bin /usr/local/opt/llvm/bin "C:/Program Files/LLVM/bin")

find_program(_clang_format NAMES clang-format HINTS ${_llvm_hints})
if(_clang_format)
    execute_process(COMMAND "${_clang_format}" --version
                    OUTPUT_VARIABLE _format_version ERROR_QUIET
                    OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(REGEX REPLACE "[\r\n].*" "" _format_version "${_format_version}")
    if(_format_version MATCHES "version ([0-9]+)" AND CMAKE_MATCH_1 GREATER_EQUAL 20)
        _cx_doctor_row("clang-format" "ok" "${_format_version}")
    else()
        _cx_doctor_install(clang-format _command)
        _cx_doctor_row("clang-format" "old" "${_format_version}; needs 20+: ${_command}")
    endif()
else()
    _cx_doctor_install(clang-format _command)
    _cx_doctor_row("clang-format" "missing" "cx fmt needs 20+: ${_command}")
endif()

find_program(_clang_tidy NAMES clang-tidy HINTS ${_llvm_hints})
if(_clang_tidy)
    execute_process(COMMAND "${_clang_tidy}" --version
                    OUTPUT_VARIABLE _tidy_version ERROR_QUIET
                    OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(REGEX REPLACE "[\r\n].*" "" _tidy_version "${_tidy_version}")
    _cx_doctor_row("clang-tidy" "ok" "${_tidy_version}")
else()
    _cx_doctor_install(clang-tidy _command)
    _cx_doctor_row("clang-tidy" "missing" "cx lint needs it: ${_command}")
endif()

find_program(_cmake_lint NAMES cmake-lint)
if(_cmake_lint)
    _cx_doctor_row("cmake-lint" "ok" "${_cmake_lint}")
else()
    _cx_doctor_install(cmake-lint _command)
    _cx_doctor_row("cmake-lint" "missing" "cx lint needs it: ${_command}")
endif()

find_program(_watchexec NAMES watchexec)
if(_watchexec)
    _cx_doctor_row("watchexec" "ok" "${_watchexec}")
else()
    _cx_doctor_install(watchexec _command)
    _cx_doctor_row("watchexec" "missing" "cx dev falls back to polling: ${_command}")
endif()

find_program(_doxygen NAMES doxygen)
if(_doxygen)
    _cx_doctor_row("doxygen" "ok" "${_doxygen}")
else()
    _cx_doctor_install(doxygen _command)
    _cx_doctor_row("doxygen" "missing" "cx docs needs it: ${_command}")
endif()

find_program(_dot NAMES dot)
if(_dot)
    _cx_doctor_row("dot (Graphviz)" "ok" "${_dot}")
else()
    _cx_doctor_install(dot _command)
    _cx_doctor_row("dot (Graphviz)" "missing" "the docs diagrams need it: ${_command}")
endif()

if(CMAKE_HOST_WIN32)
    if(DEFINED ENV{VSCMD_VER} OR DEFINED ENV{VCToolsInstallDir})
        _cx_doctor_row("developer shell" "ok" "VSCMD_VER=$ENV{VSCMD_VER}")
    else()
        _cx_doctor_install(devshell _command)
        _cx_doctor_row("developer shell" "missing" "${_command}")
    endif()
endif()

# ---- table --------------------------------------------------------------------
_cx_doctor_width("${_checks}" 7 _width_check)
_cx_doctor_width("${_statuses}" 6 _width_status)
_cx_doctor_pad("CHECK" ${_width_check} _h1)
_cx_doctor_pad("STATUS" ${_width_status} _h2)
set(_text "${_h1}  ${_h2}  DETAIL\n")
_cx_doctor_pad("" ${_width_check} _s1)
string(REPLACE " " "-" _s1 "${_s1}")
_cx_doctor_pad("" ${_width_status} _s2)
string(REPLACE " " "-" _s2 "${_s2}")
string(APPEND _text "${_s1}  ${_s2}  ------\n")
set(_index 0)
foreach(_check IN LISTS _checks)
    list(GET _statuses ${_index} _status)
    list(GET _details ${_index} _detail)
    _cx_doctor_pad("${_check}" ${_width_check} _c1)
    _cx_doctor_pad("${_status}" ${_width_status} _c2)
    string(APPEND _text "${_c1}  ${_c2}  ${_detail}\n")
    math(EXPR _index "${_index} + 1")
endforeach()
_cx_say("${_text}")

if(_required_missing)
    _cx_fail("a required tool is missing (see the table above)")
endif()
