# dev - rebuild and retest (or restart the app) on every change
#
# Usage:
#   cx dev [preset] [target...] [-- ctest args]
#   cx dev [preset] --run [-- program args]
#
# Watches src/, include/, tests/, the CMake files, VERSION and vcpkg.json
# (never build/ or docs/). With watchexec installed it runs
# `cx test` (or `cx run` for --run) on every change, restarting the program
# with --restart. Without watchexec a CMake polling loop does the same once a
# second; --run there runs the program in the foreground.

_cx_resolve("${CX_WORDS}" _preset _targets _extra)
set(CX_CONFIGURE_EXTRA "${_extra}")
if(CX_DEV_RUN)
    _cx_is_library(_library "${_preset}")
    if(_library)
        _cx_fail("this is a library project: there is no program to run.\n"
                 "Run the tests with `cx test`, or build the example consumer in "
                 "examples/ (see the README).")
    endif()
endif()
_cx_test_preset_exists("${_preset}" _has_test)
if(NOT _has_test AND NOT CX_DEV_RUN)
    _cx_fail("preset '${_preset}' has no test preset; cx dev has nothing to run.\n"
             "Use a preset with tests, or --run for the program.")
endif()

# ---- the files to watch -------------------------------------------------------
set(_watch_paths "")
foreach(_dir src include tests cmake)
    if(IS_DIRECTORY "${CX_ROOT}/${_dir}")
        list(APPEND _watch_paths "${CX_ROOT}/${_dir}")
    endif()
endforeach()
foreach(_file CMakeLists.txt CMakePresets.json VERSION vcpkg.json)
    if(EXISTS "${CX_ROOT}/${_file}")
        list(APPEND _watch_paths "${CX_ROOT}/${_file}")
    endif()
endforeach()

# The cycle is the same code as a normal `cx test`/`cx run`: watchexec calls
# the dispatcher again, so there is only one implementation to keep right.
set(_cycle test)
if(CX_DEV_RUN)
    set(_cycle run)
endif()
set(_command ${CMAKE_COMMAND} -P "${CX_ROOT}/cmake/cx/cx.cmake" -- "${_cycle}" "${_preset}")
list(APPEND _command ${_targets})
if(CX_PASSTHROUGH)
    list(APPEND _command -- ${CX_PASSTHROUGH})
endif()

find_program(CX_WATCHEXEC watchexec)
if(CX_WATCHEXEC)
    set(_args "")
    foreach(_path IN LISTS _watch_paths)
        list(APPEND _args -w "${_path}")
    endforeach()
    # cmake/cx/ is the command's own code, not the project's sources.
    list(APPEND _args --ignore "${CX_ROOT}/cmake/cx")
    list(APPEND _args --debounce 100ms)
    if(CX_DEV_RUN)
        list(APPEND _args --restart)
    endif()
    list(APPEND _args -- ${_command})
    _cx_run("${CX_WATCHEXEC}" ${_args})
    if(NOT CX_RUN_RESULT EQUAL 0)
        if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
            cmake_language(EXIT ${CX_RUN_RESULT})
        endif()
        _cx_fail("cx dev stopped (watchexec exit code ${CX_RUN_RESULT})")
    endif()
    return()
endif()

# ---- polling fallback ---------------------------------------------------------
# Every second: a signature of every watched file (its path and timestamp).
# When it changes, wait for the writes to settle and run one cycle. The build
# and the program are never started in the background: a program runs in the
# foreground, so Ctrl+C stops the loop.
function(_cx_dev_files out)
    set(_files "")
    foreach(_dir src include tests cmake)
        if(IS_DIRECTORY "${CX_ROOT}/${_dir}")
            file(GLOB_RECURSE _found RELATIVE "${CX_ROOT}" LIST_DIRECTORIES false
                 "${CX_ROOT}/${_dir}/*")
            foreach(_rel IN LISTS _found)
                if(NOT _rel MATCHES "^cmake/cx/")
                    list(APPEND _files "${_rel}")
                endif()
            endforeach()
        endif()
    endforeach()
    file(GLOB_RECURSE _found RELATIVE "${CX_ROOT}" LIST_DIRECTORIES false
         "${CX_ROOT}/CMakeLists.txt" "${CX_ROOT}/*/CMakeLists.txt"
         "${CX_ROOT}/*/*/CMakeLists.txt")
    foreach(_rel IN LISTS _found)
        if(NOT _rel MATCHES "^(build|docs|vcpkg_installed)/")
            list(APPEND _files "${_rel}")
        endif()
    endforeach()
    foreach(_file CMakePresets.json VERSION vcpkg.json)
        if(EXISTS "${CX_ROOT}/${_file}")
            list(APPEND _files "${_file}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _files)
    list(SORT _files)
    set(${out} "${_files}" PARENT_SCOPE)
endfunction()

# The install command for watchexec on this host, shown when --run needs it.
function(_cx_dev_watchexec_hint out)
    if(CMAKE_HOST_WIN32)
        set(_hint "winget install watchexec.watchexec")
    elseif(APPLE)
        set(_hint "brew install watchexec")
    else()
        set(_hint "cargo install watchexec-cli")
    endif()
    set(${out} "${_hint}" PARENT_SCOPE)
endfunction()

# The timestamp of <rel> in a signature made of "rel|time" lines.
function(_cx_dev_time_in signature rel out)
    string(FIND "${signature}" "${rel}|" _at)
    if(_at EQUAL -1)
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    string(LENGTH "${rel}" _length)
    math(EXPR _start "${_at} + ${_length} + 1")
    string(SUBSTRING "${signature}" ${_start} -1 _rest)
    string(FIND "${_rest}" "\n" _end)
    string(SUBSTRING "${_rest}" 0 ${_end} _time)
    set(${out} "${_time}" PARENT_SCOPE)
endfunction()

# _cx_dev_cycle(): one configure/build/test (or run) pass. Never exits; a
# failure only sets out_ok to OFF so the loop can wait for the next change.
function(_cx_dev_cycle preset targets run out_ok)
    _cx_ensure_configured("${preset}" _result)
    if(NOT _result EQUAL 0)
        set(${out_ok} OFF PARENT_SCOPE)
        return()
    endif()
    _cx_build("${preset}" "${targets}" _result)
    if(NOT _result EQUAL 0)
        set(${out_ok} OFF PARENT_SCOPE)
        return()
    endif()
    if(run)
        _cx_program_path("${preset}" _program _is_app)
        if(NOT _is_app)
            _cx_say("this is a library project: there is no program to run. "
                    "Use cx test, or run the example in examples/.")
            set(${out_ok} OFF PARENT_SCOPE)
            return()
        endif()
        _cx_run("${_program}" ${CX_PASSTHROUGH})
        if(NOT CX_RUN_RESULT EQUAL 0)
            set(${out_ok} OFF PARENT_SCOPE)
            return()
        endif()
        _cx_dev_watchexec_hint(_hint)
        _cx_say("[cx dev] only watchexec can restart a running program; install "
                "it with: ${_hint}")
    else()
        _cx_ctest("${preset}" _result)
        if(NOT _result EQUAL 0)
            set(${out_ok} OFF PARENT_SCOPE)
            return()
        endif()
    endif()
    set(${out_ok} ON PARENT_SCOPE)
endfunction()

_cx_say("[cx dev] watching the sources (no watchexec; polling every second)")
set(_first ON)
set(_old_files "")
set(_old_signature "")
while(TRUE)
    _cx_dev_files(_files)
    set(_signature "")
    foreach(_rel IN LISTS _files)
        file(TIMESTAMP "${CX_ROOT}/${_rel}" _time "%s" UTC)
        string(APPEND _signature "${_rel}|${_time}\n")
    endforeach()

    set(_changed "")
    if(NOT _first AND NOT _signature STREQUAL _old_signature)
        foreach(_rel IN LISTS _files)
            _cx_dev_time_in("${_old_signature}" "${_rel}" _old)
            _cx_dev_time_in("${_signature}" "${_rel}" _new)
            if(NOT _old STREQUAL _new)
                set(_changed "${_rel}")
                break()
            endif()
        endforeach()
        if(_changed STREQUAL "")
            foreach(_rel IN LISTS _old_files)
                if(NOT _rel IN_LIST _files)
                    set(_changed "${_rel}")
                    break()
                endif()
            endforeach()
        endif()
    endif()

    if(_first OR NOT _changed STREQUAL "")
        if(NOT _first)
            _cx_say("[cx dev] change in ${_changed}: rebuilding")
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.3)
        endif()
        string(TIMESTAMP _start "%s%f")
        _cx_dev_cycle("${_preset}" "${_targets}" "${CX_DEV_RUN}" _ok)
        string(TIMESTAMP _end "%s%f")
        math(EXPR _elapsed_ms "(${_end} - ${_start}) / 1000")
        math(EXPR _seconds "${_elapsed_ms} / 1000")
        math(EXPR _tenths "(${_elapsed_ms} % 1000) / 100")
        if(_ok)
            _cx_say("[cx dev] ok (${_seconds}.${_tenths}s)")
        elseif(CX_DEV_RUN)
            _cx_say("[cx dev] run failed, waiting for the next change")
        else()
            _cx_say("[cx dev] build or tests failed, waiting for the next change")
        endif()
    endif()

    set(_old_files "${_files}")
    set(_old_signature "${_signature}")
    set(_first OFF)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
endwhile()
