# <name>Config.cmake - generated by cmake/Install.cmake; found by
# find_package(<name> CONFIG) in projects that use the installed library.
@PACKAGE_INIT@

# Public dependencies of the exported targets: one find_dependency() per
# package recorded with myapp_find_dependency(... PUBLIC) in
# cmake/Dependencies.cmake. Empty when the library has none.
include(CMakeFindDependencyMacro)
@MYAPP_FIND_DEPENDENCY_CALLS@

# The <name>::<name> imported target.
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

check_required_components(@PROJECT_NAME@)
